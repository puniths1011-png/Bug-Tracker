PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wizzybug
JWT_SECRET=change_this_secret
FRONTEND_URL=http://localhost:5173

# Recommended for Render free instances: Resend uses HTTPS, so it works even
# where outbound SMTP ports are blocked. MAIL_FROM must be a verified sender
# in Resend, for example: WizzyBug <invites@your-domain.com>
# RESEND_API_KEY=re_your_api_key
# MAIL_FROM="WizzyBug" <invites@your-domain.com>

# Gmail delivery (recommended for testing)
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
MAIL_FROM=your_gmail_address@gmail.com

# Or use another SMTP provider instead of Gmail
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# MAIL_FROM=no-reply@example.com

# Cloudinary image upload configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
